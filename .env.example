# Direct connection or Supabase SESSION pooler (port 5432). Never the transaction pooler (6543).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: real model. Without it, a scripted mock model drives the agent.
ANTHROPIC_API_KEY=

# patching (default): constant DBOS version, guard step-order changes with DBOS.patch()
# build: DBOS version = BUILD_VERSION / RAILWAY_GIT_COMMIT_SHA (see docs/closeout.md, rule 4)
DBOS_VERSIONING=patching

# Bearer token for the HTTP API (required when RAILWAY_ENVIRONMENT is set).
API_TOKEN=

# Executor identity: RAILWAY_REPLICA_ID on Railway; EXECUTOR_ID locally. Never set DBOS__VMID.
EXECUTOR_ID=

HEARTBEAT_MS=5000
DEAD_AFTER_MS=30000
DRAIN_TIMEOUT_MS=20000

# Spike-only fake provider + MCP server (npm run externals)
FAKE_PROVIDER_URL=http://127.0.0.1:7801
FAKE_PROVIDER_DATABASE_URL=
