# Direct connection or Supabase SESSION pooler (port 5432). Never the transaction pooler (6543).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: real model. Without it, a scripted mock model drives the agent.
ANTHROPIC_API_KEY=

# patching (default): constant DBOS version, guard step-order changes with DBOS.patch()
# build: DBOS version = BUILD_VERSION / RAILWAY_GIT_COMMIT_SHA (see docs/closeout.md, rule 4)
DBOS_VERSIONING=patching

# Bearer token for the HTTP API (required when RAILWAY_ENVIRONMENT is set).
API_TOKEN=

# Executor identity is generated fresh per process. EXECUTOR_ID is a local-test override only
# (must still be unique per process start). Never set DBOS__VMID.
EXECUTOR_ID=

HEARTBEAT_MS=5000
DEAD_AFTER_MS=30000
DRAIN_TIMEOUT_MS=20000

# CONNECTIONS: integration credentials are encrypted at rest with this key (openssl rand -base64 32).
CONNECTION_KEY=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client, type "Web application").
# Redirect URI must be the worker's public URL + /oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Spike-only fake provider + MCP server (npm run externals)
FAKE_PROVIDER_URL=http://127.0.0.1:7801
FAKE_PROVIDER_DATABASE_URL=

# Phone app (/app): Supabase Auth magic link, restricted to ONE email. URL + publishable key are public
# (Supabase → Project Settings → API). Add <worker URL>/app to Supabase Auth → URL Configuration → Redirect URLs.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
OWNER_EMAIL=
# Base URL for links written into calendar events (default: origin of GOOGLE_REDIRECT_URI).
APP_URL=
