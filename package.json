{
  "name": "rone-agent-base",
  "version": "0.2.0",
  "description": "Durable personal automation platform on DBOS + AI SDK (spike).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "externals": "node --import tsx src/externals.ts",
    "typecheck": "tsc -p .",
    "suite": "tsx scripts/failure-suite.ts",
    "upgrade-test": "bash scripts/upgrade-test.sh"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/mcp": "2.0.84",
    "@dbos-inc/dbos-sdk": "5.3.0",
    "@dbos-inc/vercel-ai": "0.5.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ai": "7.0.153",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
